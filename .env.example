# Bring! credentials
# Copy this to .env and fill in your details
# (or pass as environment variables in claude_desktop_config.json)

BRING_EMAIL=your@email.com
BRING_PASSWORD=your_password

# Optional: restrict access to specific shopping lists.
# Comma-separated list of list names or UUIDs.
# When set, only the listed lists will be visible or accessible via any tool.
# When unset or empty, all lists are accessible (default behaviour).
#
# Examples:
#   BRING_LIST_ALLOWLIST=Groceries
#   BRING_LIST_ALLOWLIST=Groceries,Hardware Store
#   BRING_LIST_ALLOWLIST=a1b2c3d4-e5f6-7890-abcd-ef1234567890
#
# BRING_LIST_ALLOWLIST=
